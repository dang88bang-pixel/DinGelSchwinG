desktop/data/system_instruction_custom.txt

# ── MCP-Bridge & mobile-server: Laufzeit-/Schlüsseldateien ────────────────────
# Schlüssel gehören nicht ins Git (Root-Keys am Agenten, PSK am Gateway)
keys.json
**/keys.json
*.key
*.keys
*.pem
*.p12
mobile-server/data/gateway_audit.jsonl
mobile-server/data/sessions.json
mobile-server/data/ble_*.json
# Software-Grabber: importierte Asset-Bytes + Katalog-Index sind Laufzeitdaten
mobile-server/data/imports/
# PortView/Discovery-Selbsttest-Hilfen
mobile-server/data/.selftest-*/
mobile-server/**/__pycache__/
mobile-server/.venv/

# Desktop-Konsole: Wissensbasis, Gallerie-Zustand, Laufzeit-Auswertung
desktop/data/knowledge/
desktop/data/gallery_state.json
desktop/data/agent_runs.json
desktop/data/agent_runs*.jsonl
desktop/data/keys.json
desktop/data/crash_*.json

# Lokale Modell-Dateien (transformers.js / GGUF)
public/models/
*.onnx
*.gguf
*.safetensors

# Backend runtime (server/)
# A-1: `server/data/` ist Laufzeit (data.db, Audit), ABER die Skript-Whitelist
# unter `server/data/scripts/` ist Quellcode und muss versioniert sein
# (SHA-256-Pinning in manifest.json wirkt nur gegen eingecheckte Dateien).
# A-5: `server/data/adb/` ist das Ziel für `adb pull`/`adb install` (Laufzeit).
server/data/*
!server/data/scripts/
server/**/__pycache__/
logs/
