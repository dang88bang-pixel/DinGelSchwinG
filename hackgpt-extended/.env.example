# ═══════════════════════════════════════════════════════════════════
# NEXUS-BUILDER v2.2 — Produktions-Konfiguration (Kopie als .env anlegen)
# ═══════════════════════════════════════════════════════════════════

# ── Betriebsmodus ──────────────────────────────────────────────────
# development (Default) | production  → production erzwingt SECRET_KEY
APP_ENV=production

# ── Sicherheit ─────────────────────────────────────────────────────
# PFLICHT in Produktion (min. 32 Zeichen):  openssl rand -hex 32
SECRET_KEY=

# Ersten Admin automatisch anlegen (idempotent, nur wenn E-Mail fehlt)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ROLE=expert

# WebAuthn (FIDO2): erwartete Origin + RP-ID (sonst vom Browser abgeleitet)
# WEBAUTHN_ORIGIN=https://console.example.com
# WEBAUTHN_RP_ID=console.example.com
# Demo-Bypass NUR Entwicklung (nie in Produktion setzen!):
# WEBAUTHN_DEMO_BYPASS=1

# ── Frontend-Basis-URLs (zur Build-Zeit, Vite) ─────────────────────
# Echte Domain — ohne Setzung wird same-origin (Reverse-Proxy) verwendet.
VITE_API_BASE=https://console.example.com
VITE_WS_BASE=wss://console.example.com

# ── Terminal-Bridge (pyserial / SSH) ───────────────────────────────
# Serielles Gerät (USB-C-Dongle / Hardware); ohne Setzung: Auto-Detect
# /dev/ttyACM* → /dev/ttyUSB*
SERIAL_DEVICE=/dev/ttyACM0
SERIAL_BAUD=115200
# Demo-Fallback (cat-PTY) NUR in Entwicklung: SERIAL_PTY_FALLBACK=1
SSH_KEY_PATH=/run/secrets/service_ed25519
SSH_USER=service
# SSH_STRICT_HOSTKEYS=1  (Produktion: strict by default)
TERM_IDLE_TIMEOUT=600
TERM_ABS_TIMEOUT=3600

# ── Discovery-Scanner ──────────────────────────────────────────────
SCAN_INTERVAL=15
NODE_TTL=90
# Achtung: network_mode: host (mDNS/BLE) — Port 8766 muss am Host frei sein!
SCAN_PORT=8766

# ── Docker: Host-Geräte an die Zielmaschine anpassen ───────────────
HOST_TTY_ACM=/dev/ttyACM0
HOST_TTY_USB=/dev/ttyUSB0
