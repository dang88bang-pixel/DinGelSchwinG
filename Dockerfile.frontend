# NEXUS-BUILDER – Web-Frontend (Vite/React → Nginx, SPA-Fallback + API-Proxy)
# Start:  docker compose up -d --build frontend
FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
# SPA-Fallback + Proxy /api → backend:5000, WS-Kanäle → backend:8765/8766/8767
COPY deploy/nginx-frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
