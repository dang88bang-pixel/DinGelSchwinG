# NEXUS-BUILDER – Umgebungsvariablen-Vorlage
# Kopieren nach .env und anpassen:  cp .env.example .env
# (docker compose liest .env automatisch)

# --- Sicherheit (MUSS in Produktion geändert werden!) ---
NEXUS_JWT_SECRET=your-super-secret-key-here-min-32-characters
NEXUS_WEBAUTHN_REQUIRED=true

# --- Zugänge (RBAC-Rollen: guest/operator/service/developer/expert/emergency/admin) ---
# Ohne Angabe erzeugt der Host beim ersten Start zufällige Dev-Passwörter
# in host/data/dev_users.json und gibt sie im Log aus.
NEXUS_USER_admin=bitte-aendern:admin
NEXUS_USER_service=bitte-aendern:service

# --- Datenbank (SQLite, WAL, automatische Migration) ---
NEXUS_DB_PATH=/app/host/data/nexus.db

# --- Rate-Limiting (Login-Versuche pro Minute und IP – Brute-Force-Schutz) ---
NEXUS_RATE_LIMIT_LOGIN=10
NEXUS_RATE_LIMIT_WINDOW=60

# --- Ports (REST + WS-Kanäle) ---
NEXUS_REST_PORT=5000
NEXUS_WS_TERMINAL=8765
NEXUS_WS_DISCOVERY=8766
NEXUS_WS_STATUS=8767

# --- Scan-Zyklus (Sekunden) ---
NEXUS_SCAN_INTERVAL=8.0

# --- Optional: lokales KI-Modell (Web-App lädt Qwen2.5 via transformers.js
#     direkt im Browser; hier nur Platzhalter für serverseitige Modelle) ---
# MODEL_PATH=/models/Qwen2.5-0.5B
