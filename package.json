{
  "name": "dingelschwinng-moe-agent",
  "version": "1.0.0",
  "description": "MoE Agent Chat with System-Critical Permission Guards - Android APK",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "android:build": "npm run build && npx cap copy android && npx cap open android",
    "android:sync": "npx cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:apk:release": "cd android && ./gradlew assembleRelease",
    "android:install": "cd android && ./gradlew installDebug",
    "capacitor:add": "npx cap add android",
    "capacitor:sync": "npx cap sync",
    "mcp:bridge": "node mcp/bridge.mjs",
    "mcp:start": "node node_modules/@cristianoaredes/mcp-mobile-server/dist/server.js",
    "mcp:list": "node mcp/list-tools.mjs",
    "mcp:gateway": "python3 mobile-server/mobile_ble_server.py --mock",
    "mcp:gateway:selftest": "python3 mobile-server/mobile_ble_server.py selftest",
    "mcp:gateway:tests": "python3 mobile-server/tests/test_gateway.py",
    "dev:full": "concurrently -n app,mcp,gw -c cyan,magenta,yellow \"npm run dev\" \"npm run mcp:bridge\" \"npm run mcp:gateway\"",
    "mcp:portview": "python3 mobile-server/discovery.py",
    "mcp:gateway:status": "curl -s http://127.0.0.1:8791/status"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/device": "^8.0.3",
    "@capacitor/network": "^8.0.1",
    "@cristianoaredes/mcp-mobile-server": "^2.3.0",
    "@huggingface/transformers": "3.8.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "html5-qrcode": "^2.3.8",
    "i18next": "^23.16.8",
    "lucide-react": "1.31.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^15.7.4",
    "terser": "^5.49.2",
    "three": "^0.185.1",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "happy-dom": "^20.14.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0",
    "vite": "^4.4.0",
    "vitest": "^0.34.6"
  },
  "type": "module"
}
