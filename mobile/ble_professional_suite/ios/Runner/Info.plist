<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- BLE Berechtigungen -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>BLE Professional Suite benötigt Bluetooth, um BLE-Geräte zu scannen, zu verbinden und Mesh-Netzwerke zu konfigurieren.</string>

    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>BLE Professional Suite benötigt Bluetooth, um als BLE-Gerät zu agieren.</string>

    <key>NSLocationWhenInUseUsageDescription</key>
    <string>BLE Professional Suite benötigt Standortzugriff, um BLE-Geräte in Ihrer Umgebung zu finden.</string>

    <key>NSFaceIDUsageDescription</key>
    <string>BLE Professional Suite verwendet Face ID zur Bestätigung kritischer Aktionen (WebAuthn-Äquivalent).</string>

    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
        <string>bluetooth-peripheral</string>
    </array>

    <!-- Weitere Standardeinstellungen -->
    <key>CFBundleName</key>
    <string>BLE Professional Suite</string>
    <key>CFBundleDisplayName</key>
    <string>BLE Pro Suite</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
</dict>
</plist>
