# --- Neo4j ----------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# --- Gemini AI ------------------------------------------------------------
# Obtain a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Dynamic driver / protocol loader (Mixture-of-Experts) -----------------
# GitHub Release asset URL of a controller-parser package (zip of a Python pkg).
DRIVER_GITHUB_RELEASE_URL=
# S3 bucket + key prefix used when drivers are fetched from object storage.
DRIVER_S3_BUCKET=
DRIVER_S3_PREFIX=drivers/

# --- Server -----------------------------------------------------------------
WS_PATH=/ws/telemetry
