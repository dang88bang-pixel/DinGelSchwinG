# ── Kern (Server-Backend gemäß README) ─────────────────────────────
SECRET_KEY=                      # openssl rand -hex 32  (JWT-Signatur, niemals committen)
VITE_API_BASE=https://yourdomain.com
DATABASE_URL=sqlite:///data.db   # Produktion: postgresql+psycopg://nexus:PASS@db:5432/nexus

# ── Terminal-Bridge / Hardware (docs/hardware-setup.md) ────────────
DINGELSCHWING_SSH_KEY=/etc/dingelschwing/bridge_ed25519
# PTY-Ziel: /dev/ttyACM0 (seriell) oder ssh://host

# ── LDAP (docs/production-backend.md §4) ───────────────────────────
LDAP_URI=ldaps://ldap.example.com:636
LDAP_BASE_DN=dc=example,dc=com
LDAP_GROUP_DN=ou=groups,dc=example,dc=com

# ── OAuth2/OIDC SSO (§5) ───────────────────────────────────────────
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER=https://sso.example.com/realms/nexus

# ── Härtungsparameter (README §11) ─────────────────────────────────
RATE_WINDOW=60
RATE_MAX_HITS=20
SCAN_MAX_CLIENTS=50
STATUS_MAX_CLIENTS=50

# ── Monitoring (deploy/monitoring) ─────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change-me
SLACK_WEBHOOK_URL=               # https://hooks.slack.com/services/...
LOKI_RETENTION=720h              # 30 Tage
