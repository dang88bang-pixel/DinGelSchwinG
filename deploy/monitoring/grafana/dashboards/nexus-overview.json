{
  "title": "NEXUS – Übersicht",
  "uid": "nexus-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "up{job=\"nexus-backend\"}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP-Requests/s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(rate(http_requests_total[5m]))", "refId": "A", "legendFormat": "gesamt" },
        { "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))", "refId": "B", "legendFormat": "5xx" }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "App-Logs (Loki, trace_id filterbar)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        { "expr": "{container=~\".+\"} |~ \"\\\\\\\"level\\\\\\\":\\\\\\\"(error|warning)\\\\\\\"\"", "refId": "A" }
      ]
    }
  ]
}
